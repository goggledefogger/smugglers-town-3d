{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/) && newData.hasChildren(['host', 'createdAt', 'phase', 'seed', 'map'])",
        "host": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "phase": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
        },
        "seed": {
          ".validate": "newData.isNumber()"
        },
        "keyShared": {
          ".validate": "newData.isBoolean()"
        },
        "map": {
          ".validate": "newData.hasChild('kind') && (newData.child('kind').val() === 'desert' || newData.hasChildren(['query', 'label', 'lat', 'lon']))",
          "kind": {
            ".validate": "newData.val() === 'desert' || newData.val() === 'city'"
          },
          "query": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "label": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lon": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (!newData.exists() || data.exists() || data.parent().parent().child('phase').val() === 'lobby')",
            ".validate": "newData.hasChildren(['name', 'vehicle', 'team', 'ready', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "vehicle": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "team": {
              ".validate": "newData.val() === 0 || newData.val() === 1"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tokens": {
      "$code": {
        ".read": "auth != null && root.child('rooms/' + $code + '/host').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": "auth != null && $uid === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
        }
      }
    },
    "signal": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "logs": {
      "$session": {
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['t', 'l', 's', 'm', 'u']) && newData.child('u').val() === auth.uid",
          "t": {
            ".validate": "newData.isNumber()"
          },
          "l": {
            ".validate": "newData.isString() && newData.val().length <= 5"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "u": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
