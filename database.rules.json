{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/) && newData.hasChildren(['host', 'createdAt', 'phase', 'seed', 'map'])",
        "host": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "phase": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
        },
        "seed": {
          ".validate": "newData.isNumber()"
        },
        "map": {
          ".validate": "newData.hasChild('kind')",
          "kind": {
            ".validate": "newData.val() === 'desert' || newData.val() === 'city'"
          },
          "query": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (!newData.exists() || data.exists() || data.parent().parent().child('phase').val() === 'lobby')",
            ".validate": "newData.hasChildren(['name', 'vehicle', 'team', 'ready', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "vehicle": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "team": {
              ".validate": "newData.val() === 0 || newData.val() === 1"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tokens": {
      "$code": {
        ".read": "auth != null && root.child('rooms/' + $code + '/host').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": "auth != null && $uid === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
        }
      }
    },
    "signal": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
