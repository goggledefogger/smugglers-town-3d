rules_version = '2';

// Deny-all default. Nothing reads or writes Firestore until a feature needs
// it; open each collection deliberately, scoped to an authenticated user.
// Not wired into firebase.json yet — see docs/DEPLOY.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
